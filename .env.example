# Supabase (хоосон үлдээвэл апп локал демо өгөгдлөөр ажиллана)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Зөвхөн серверт. Хөтөч рүү хэзээ ч бүү гарга.
# SUPABASE_SERVICE_ROLE_KEY=

# Локал нэвтрэлтийн күүки. Production дээр урт санамсаргүй тэмдэгт мөр.
SESSION_SECRET=change-me-to-a-long-random-string

# Production дээр туршилтын нэвтрэлтийг харуулах бол true
DEMO_MODE=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
